# Canonical production site URL, used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://widian.tech

# Used outside Vercel to distinguish a production build from local/preview.
# Vercel supplies VERCEL_ENV automatically.
# DEPLOYMENT_ENV=production

# Book a Demo lead capture (POST /api/walkthrough), per DECISIONS.md D-007/D-008/D-039.
# The first four are required; if any is missing the
# form is not shown and /book-a-demo keeps its email-only layout. Server-only: never prefix with NEXT_PUBLIC_.
# Use the ISOLATED marketing Supabase project (D-007), never the operational Widian project.
# Apply supabase/marketing/001_demo_enquiries.sql first.
# MARKETING_SUPABASE_URL=https://<marketing-project>.supabase.co
# MARKETING_SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# LEAD_EMAIL_FROM="Widian <demo@mail.widian.tech>"   # must be on a domain verified in Resend (SPF/DKIM/DMARC)
# LEAD_NOTIFY_TO=                                     # optional override; defaults to info@widian.tech (D-040)
# LEAD_EMAIL_REPLY_TO=info@widian.tech                # optional; defaults to the published enquiry mailbox
# CAL_BOOKING_URL=https://cal.com/<team>/<event>      # optional; offered as a link after the enquiry is stored (D-039/D-040, Cal.com Cloud, link only)

# Per-instance rate limit for the endpoint (defaults: 5 requests per 600 seconds per client).
# RATE_LIMIT_MAX_REQUESTS=
# RATE_LIMIT_WINDOW_SECONDS=

# Analytics — GA4 with Consent Mode (D-011). Not yet wired up; requires
# a cookie-consent banner before this loads, per PRIVACY_AND_UK_GDPR_PLAN.md.
# ANALYTICS_GA4_MEASUREMENT_ID=

# Cookie/consent configuration — blocked on privacy owner assignment
# (D-010, D-012).
# CONSENT_MODE=
